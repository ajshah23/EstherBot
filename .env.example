# Database
DATABASE_URL="postgresql://user:password@localhost:5432/grocery_optimizer?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Encryption (for credential storage)
ENCRYPTION_MASTER_KEY="your-32-byte-encryption-key-here"

# Optional: Redis (for caching and job queue)
REDIS_URL="redis://localhost:6379"
